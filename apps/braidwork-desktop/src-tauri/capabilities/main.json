{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window: explicit file selection and clipboard writing only. External URLs are validated in a Rust command.",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    "clipboard-manager:allow-write-text",
    "allow-create-project",
    "allow-open-project",
    "allow-close-project",
    "allow-workspace-snapshot",
    "allow-create-resource",
    "allow-create-agent",
    "allow-create-session",
    "allow-create-task",
    "allow-set-task-status",
    "allow-create-assignment",
    "allow-create-delegation",
    "allow-prepare-capsule",
    "allow-render-capsule",
    "allow-mark-dispatched",
    "allow-ingest-text",
    "allow-ingest-file",
    "allow-assignment-detail",
    "allow-result-detail",
    "allow-open-external-reference"
  ]
}
